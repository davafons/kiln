<section class="mx-auto flex max-w-page flex-col items-start gap-content px-gutter pt-16 pb-12 sm:pt-24">
  <p class="<%= lc_text_class(size: :eyebrow, tone: :muted) %>">A Ruby gem for Rails 8.1</p>
  <h1 class="<%= lc_heading_class(size: :display, extra: "max-w-2xl sm:text-5xl sm:leading-tight") %>">Fire a Rails app into a static site.</h1>
  <p class="<%= lc_text_class(tone: :muted, extra: "max-w-2xl text-lg") %>">Kiln renders every GET route of a Rails app through Rack and writes plain files that any static host can serve. You keep routes, controllers, views, Turbo and Stimulus, and develop with <code>bin/rails server</code>.</p>
  <div class="flex flex-wrap gap-related pt-related">
    <%= lc_button_link_to "Read the docs", page_path("introduction"), size: :lg %>
    <%= lc_button_link_to "Install", page_path("installation"), variant: :outline, size: :lg %>
  </div>
</section>

<section class="mx-auto grid max-w-page gap-content px-gutter pb-section sm:grid-cols-3">
  <%= lc_card do |card| %>
    <%= card.header title: "Routes are the page list" %>
    <%= card.content do %><p class="<%= lc_text_class(tone: :muted) %>">Every GET route is a page. A route with params needs a param source, or the build names the line to add.</p><% end %>
  <% end %>
  <%= lc_card do |card| %>
    <%= card.header title: "The build fails loudly" %>
    <%= card.content do %><p class="<%= lc_text_class(tone: :muted) %>">Render errors, missing assets, broken links and anchors are all reported at once, and the task exits non-zero.</p><% end %>
  <% end %>
  <%= lc_card do |card| %>
    <%= card.header title: "Kiln knows nothing about your data" %>
    <%= card.content do %><p class="<%= lc_text_class(tone: :muted) %>">Models, repositories and Markdown stay ordinary app code. Kiln only sees the responses.</p><% end %>
  <% end %>
</section>

<section class="mx-auto max-w-page px-gutter pb-24">
  <div class="flex max-w-reading flex-col gap-content">
    <h2 class="<%= lc_heading_class(size: :title) %>">Three steps</h2>
    <%= lc_code_block %(# Gemfile\ngem "kiln"), id: "step-gemfile", language: "ruby", title: "Add the gem", max_lines: nil %>
    <%= lc_code_block %(# config/kiln.rb\nKiln.configure do |config|\n  config.url = "https://example.com"\nend\n\nKiln.pages do\n  params :post, -> { Post.published.map { { slug: it.slug } } }\nend), id: "step-config", language: "ruby", title: "Declare the pages", max_lines: nil %>
    <%= lc_code_block "RAILS_ENV=production bin/rails kiln:build", id: "step-build", language: "shell", title: "Build into dist/", max_lines: nil %>
    <p class="<%= lc_text_class(tone: :muted) %>">This site is a Rails app built with Kiln. Its source is in the <%= lc_link "docs folder", "https://github.com/davafons/kiln/tree/main/docs" %> of the repository.</p>
  </div>
</section>
